# OpenAI API key for the Producer and optional Responses Builder. Never commit the real key.
OPENAI_API_KEY=
# Set model IDs only after verifying availability with pnpm smoke:openai.
PRODUCER_MODEL=
# Builder implementation: codex or responses.
BUILDER=codex
BUILDER_MODEL=
# Twitch application credentials; keep real values in the ignored .env file.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
PORT=3000
# Chat source: twitch or simulator.
CHAT_SOURCE=simulator
