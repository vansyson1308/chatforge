{
  "name": "chatforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "clean:runtime": "node scripts/clean-runtime.mjs",
    "forge:dry-run": "pnpm --filter @chatforge/server forge:dry-run",
    "dev": "pnpm build && pnpm --parallel --filter @chatforge/server --filter @chatforge/overlay --filter @chatforge/dashboard dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run apps/server/src/stream.e2e.test.ts",
    "format": "prettier --write .",
    "smoke:codex": "pnpm --filter @chatforge/server smoke:codex",
    "smoke:openai": "pnpm --filter @chatforge/server smoke:openai",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:fps": "node scripts/measure-overlay.mjs",
    "start": "pnpm --filter @chatforge/server dev",
    "stream": "pnpm build && node scripts/stream.mjs",
    "forge:soak": "pnpm build && node scripts/soak-forge.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.12"
  }
}
